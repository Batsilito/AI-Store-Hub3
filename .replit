modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5050
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 20913
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Keytopia preview"

[[workflows.workflow]]
name = "Start Keytopia preview"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "(export ADMIN_EMAILS=bassamihab@gmail.com; pnpm --filter @workspace/api-server run build && PORT=8080 NODE_ENV=development pnpm --filter @workspace/api-server run start) & (PORT=5000 BASE_PATH=/ API_PROXY_TARGET=http://127.0.0.1:8080 pnpm --filter @workspace/keytopia run dev) & wait"
waitForPort = 5000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-a05bddcf-5891-4c2c-b306-15405b5a99c8"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "run", "start"]
build = ["pnpm", "run", "build"]

[userenv]

[userenv.production]
ADMIN_EMAILS = "bassamihab@gmail.com"
